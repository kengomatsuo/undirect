					<h2 class="article-copy-block--heading ">How to find Insights</h2>
                    
        






   

    
        
        
  
        
        







    
        

        

 		
		
		


        


		


		

		


        

        

        
		
					
                    <p class="article-copy-block--description ">In the upper-right corner of your Campaigns dashboard, Ad Groups dashboard, Ads dashboard, or Keywords tab, click the Insights link.</p>
        






   

    
        
        
  
        
        








 	
    

	


	


        

         

        



		

        

        

     
     

    

    

    







   

    
        
        
  
        
        






    
    
    
    
    
    
    
        
        
    
        
      
    






   

    

































