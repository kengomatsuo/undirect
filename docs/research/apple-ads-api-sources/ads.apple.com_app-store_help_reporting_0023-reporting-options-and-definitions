					<h3 class="article-copy-block--label ">Redownloads (Total)</h3>
                    
        






   

    
        
        
  
        
        







    
        

        

 		
		
		


        


		


		

		


        

        

        
		
					
                    <p class="article-copy-block--description ">The total number of tap-through and view-through redownloads within the reporting period.</p>
        






   

    
        
        
  
        
        






    
    
    
    
    
    
    
        
        
    
        
      
    






   

    

































</section>
