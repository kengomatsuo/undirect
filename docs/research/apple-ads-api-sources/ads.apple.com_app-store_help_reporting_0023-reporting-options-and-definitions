					<h3 class="article-copy-block--label ">Average CPA (Tap-Through)</h3>
                    
        






   

    
        
        
  
        
        







    
        

        

 		
		
		


        


		


		

		


        

        

        
		
					
                    <p class="article-copy-block--description ">Tap-through average cost-per-acquisition (CPA) is total campaign spend divided by the number of taps on your ad that led to installs within the reporting period. </p>
        






   

    
        
        
  
        
        






    
    
    
    
    
    
    
        
        
    
        
      
    






   

    

































</section>
<section class="article-copy-block margin-bottom--25-25-25">










































    
        
        
  
        
        







    
        

        

 		
		
		


        


		


		

		


        

        

        
		
					
                    
        






   

    
        
        
  
        
        







    
        

        

 		
		
		


        


		


		

		


        

        

        
		
					<h3 class="article-copy-block--label ">Average CPA (Total)</h3>
                    
        






   

    
        
        
  
        
        







    
        

        

 		
		
		


        


		


		

		


        

        

        
		
					
                    <p class="article-copy-block--description ">Total average tap-through cost-per-acquisition (CPA) is total campaign spend divided by total installs resulting from a view or a tap on your ad within the reporting period.</p>
        






   

    
        
        
  
        
        






    
    
    
    
    
    
    
        
        
    
        
      
    






   

    

































</section>
<section class="article-copy-block margin-bottom--25-25-25">










































    
        
        
  
        
        







    
        

        

 		
		
		


        


		


		

		


        

        

        
		
					
                    
        






   

    
        
        
  
        
        







    
        

        

 		
		
		


        


		


		

		


        

        

        
		
