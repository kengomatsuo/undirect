					<h3 class="article-copy-block--label ">Rank</h3>
                    
        






   

    
        
        
  
        
        







    
        

        

 		
		
		


        


		


		

		


        

        

        
		
					
                    <p class="article-copy-block--description ">How your app ranks in terms of Impression Share (First Ad Position) or Impression Share (All Ad Positions) compared to other apps in the same countries and regions. Rank is displayed as numbers from 1 to 5 or &gt;5, with 1 being the highest rank. This metric is only available in predefined Impression Share reports and on the Recommendations page.</p>
        






   

    
        
        
  
        
        






    
    
    
    
    
    
    
        
        
    
        
      
    






   

    

































</section>
