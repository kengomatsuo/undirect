					<h3 class="article-copy-block--label ">Redownloads (Tap-Through)</h3>
                    
        






   

    
        
        
  
        
        







    
        

        

 		
		
		


        


		


		

		


        

        

        
		
					
                    <p class="article-copy-block--description ">A redownload is when a user downloads your app, deletes it, then downloads it again on the same device or a different one following an ad tap. A tap-through redownload is counted when a user redownloads your app within 30 days of tapping on the ad.</p>
        






   

    
        
        
  
        
        






    
    
    
    
    
    
    
        
        
    
        
      
    






   

    

































</section>
