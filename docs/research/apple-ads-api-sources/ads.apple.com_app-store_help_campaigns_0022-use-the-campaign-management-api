					<h2 class="article-copy-block--heading ">Request a third-party account</h2>
                    
        






   

    
        
        
  
        
        







    
        

        

 		
		
		


        


		


		

		


        

        

        
		
					
                    <p class="article-copy-block--description ">If you’re a third-party service provider developing marketing solutions on the Apple Ads Platform API for ads on the App Store or Apple Maps, please contact <a href="mailto:ads-registration&#64;group.apple.com" aria-label="ads-registration&#64;group.apple.com">ads-registration&#64;group.apple.com</a> for more information on registering a third-party OAuth 2 application.</p>
        






   

    
        
        
  
        
        








 	
    

	


	


        

         

        



		

        

        

     
     

    

    

    







   

    
        
        
  
        
        






    
    
    
    
    
    
    
        
        
    
        
      
    






   

    

































