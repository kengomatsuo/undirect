    },
    "app.welcome.feature.invisible_layers.detail": {
      "s": "પારદર્શક સ્તર પાનાને ઢાંકીને બીજા માટેનો ટૅપ પકડી લઈ શકે છે.",
      "back": "A transparent layer can cover the page and catch a tap meant for another"
