    "app.welcome.heading": {
      "s": "Undirect-க்கு வரவேற்கிறோம்",
      "back": "Welcome to Undirect"
    },
    "app.welcome.feature.invisible_layers.title": {
      "s": "கண்ணுக்குத் தெரியாத அடுக்குகள்",
      "back": "Invisible layers"
    },
    "app.welcome.feature.invisible_layers.detail": {
      "s": "ஒரு வெளிப்படையான அடுக்கு பக்கத்தை மூடி, வேறொன்றுக்கான தட்டலைப் பிடித்துக்கொள்ளலாம்.",
      "back": "A transparent layer can cover the page and catch a tap meant for something else"
    },
    "app.welcome.feature.swapped_links.title": {
      "s": "மாற்றப்பட்ட இணைப்புகள்",
      "back": "Swapped links"
    },
    "app.welcome.feature.swapped_links.detail": {
      "s": "சில பக்கங்கள் அழுத்துவதற்கும் விடுவதற்கும் இடையில் இணைப்பின் இலக்கை மாற்றிவிடுகின்றன.",
      "back": "Some pages change a link's target between pressing and releasing"
    },
    "app.welcome.feature.uninvited_windows.title": {
      "s": "கேட்காத சாளரங்கள்",
      "back": "Windows not asked for"
    },
    "app.welcome.feature.uninvited_windows.detail": {
      "s": "பாதுகாப்பு இயக்கத்தில் இருக்கும்போது, புதிய தாவல் நீங்கள் தட்டிய இடத்துக்கு மட்டுமே திறக்கும்.",
      "back": "With protection on a new tab opens only to where you tapped"
    },
    "app.welcome.feature.every_destination.title": {
      "s": "ஒவ்வொரு இலக்கும்",
      "back": "Every destination"
    },
    "app.welcome.feature.every_destination.detail": {
      "s": "ஒவ்வொரு இலக்கிற்கும் தனி வரிசை இருக்கும். ஒரு தளத்திலோ எல்லா தளங்களிலோ அனுமதிக்கலாம் அல்லது தடுக்கலாம்.",
      "back": "Each destination has its own row; allow or block on one site or all"
    },
