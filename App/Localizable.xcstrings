    "Some pages rewrite a link between the press and the release.": {
      "extractionState": "manual",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace cambia de destino justo antes de soltar la pulsación."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains liens changent de destination entre l'appui et le relâchement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押してから離すまでの一瞬でリンクの行き先が変わり、思った場所に進めません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些网页会在你按下和松开之间，偷偷换掉链接指向的地方。"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Seiten tauschen das Linkziel im Moment des Klicks aus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian situs mengganti tujuan tautan tepat saat kamu menekannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni link cambiano destinazione nell'istante tra pressione e rilascio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누르는 순간과 떼는 순간 사이에 링크 주소가 바뀝니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns sites trocam o destino do link bem na hora do toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые страницы меняют адрес ссылки в момент нажатия."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些網站會在按下與放開之間，偷偷換掉連結的目的地。"
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تُغيّر بعض الصفحات وجهة الرابط بين ضغطك وإفلاته، فلا تصل حيث توقعت."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दबाने और छोड़ने के बीच कुछ पेज लिंक का पता बदल देते हैं।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số trang đổi đích liên kết ngay giữa lúc nhấn và lúc thả tay."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı sayfalar bağlantıyı basışla bırakış arasında değiştirir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel linku może się zmienić w chwili między naciśnięciem a puszczeniem."
          }
        },
        "nl-NL": {
          "stringUnit": {
