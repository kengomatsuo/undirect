    "A page can cover itself to catch a press meant for something else.": {
      "extractionState": "manual",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Una capa invisible cubre la página y desvía tu pulsación."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couche invisible peut intercepter un appui destiné à autre chose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "透明な層がページに重なり、押した場所とは違うものが反応します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面上可能盖着一层看不见的东西，你点的不是你以为点的地方。"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine unsichtbare Ebene liegt über der Seite und fängt den Klick ab."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapisan tak terlihat bisa menutupi halaman dan mengubah arah klikmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno strato invisibile può coprire la pagina e intercettare la pressione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보이지 않는 막이 화면을 덮어 다른 곳이 대신 눌립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
