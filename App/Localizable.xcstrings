    "Guarded sites no longer steal your clicks.": {
      "extractionState": "manual",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la protección activada, ningún sitio podrá secuestrar tus pulsaciones."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois un site protégé, il ne peut plus détourner vos appuis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトを保護すると、意図しないクリックやタップを乗っ取られなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站一旦开启防护，就无法再劫持你的点按。"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschützte Websites können Ihre Klicks nicht mehr umleiten."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah aktif, situs tak bisa lagi membajak klikmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la protezione attiva, i siti non possono più dirottare i clic."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가드를 켜면 페이지가 탭과 클릭을 가로채지 못합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de ativada, nenhum site protegido consegue mais desviar o seu toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Под защитой сайт больше не сможет перехватывать нажатия."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網站一旦受到防護，就無法再劫持你的點按。"
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تفعيلها، لا يخطف أي موقع محمي ضغطاتك بعد الآن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षा चालू होते ही कोई साइट आपके क्लिक पर कब्ज़ा नहीं कर पाएगी।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi trang được bảo vệ, không thao tác nhấn nào bị cướp nữa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir site korumaya alındığında, tıklamalarınızı artık ele geçiremez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu ochrony strona przestaje przejmować kliknięcia."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Met bescherming aan kan een site je klik niet meer omleiden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดการป้องกันให้ไซต์แล้ว หน้าเว็บจะแย่งการกดของคุณไม่ได้อีก"
          }
        }
      }
    },
