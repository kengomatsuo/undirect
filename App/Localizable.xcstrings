    "A new tab opens only where your press pointed.": {
      "extractionState": "manual",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la protección activa, la pestaña solo abre donde apuntabas."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouvel onglet ne s'ouvre que là où vous avez vraiment appuyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護中は、押した場所が開くタブだけが開き、余計なものは紛れ込みません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防护开启后，新标签页只会打开你点的那个目的地，不会额外夹带别的。"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Tab öffnet nur das Ziel, das Sie tatsächlich angeklickt haben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab baru hanya terbuka ke tujuan yang kamu tekan, tidak ada yang menyelinap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la protezione attiva, si apre solo la scheda che hai scelto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가드를 켜면 누른 곳으로만 새 탭이 열리고, 다른 것은 끼어들지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a proteção ativa, uma aba nova só abre onde você realmente tocou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С защитой новая вкладка откроет только то, что вы нажали."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防護開啟後，新分頁只會開向你點按的目的地，不會多開別的。"
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "مع الحماية، لا يفتح تبويب جديد إلا فيما ضغطت عليه فعلًا، بلا إضافات خفية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षा के साथ नया टैब सिर्फ़ वहीं खुलेगा, जहां आपने टैप किया।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật bảo vệ, tab mới chỉ mở đúng nơi cú nhấn nhắm tới."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koruma açıkken yeni sekme yalnızca bastığınız yere açılır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z włączoną ochroną nowa karta otwiera tylko to, co naciśnięto."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Met bescherming aan opent een nieuw tabblad alleen waar je zelf op klikte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดการป้องกัน แท็บใหม่จะเปิดไปยังปลายทางที่คุณกดเท่านั้น ไม่มีอะไรแอบตามมา"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুরক্ষা চালু থাকলে নতুন ট্যাব শুধু সেখানেই খোলে, যেখানে আপনি ট্যাপ করেছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb la protecció activa, una pestanya nova només s'obre allà on has tocat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při zapnuté ochraně se nový panel otevře jen tam, kam jste klepli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
