          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με ενεργή προστασία, μια νέα καρτέλα ανοίγει μόνο εκεί που πάτησες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
