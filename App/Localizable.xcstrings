    "Open a page in Safari once and this fills in.": {
      "extractionState": "manual",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre cualquier página en Safari y esto se completará."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une page dans Safari : la liste apparaîtra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariで何かページを開くと、ここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 里打开一个网页，这里就会显示内容。"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie einmal eine Seite in Safari."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka satu halaman di Safari, layar ini akan terisi sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri una pagina in Safari e i dati appariranno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari에서 아무 페이지나 한 번 열면 자동으로 채워집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma página no Safari e a lista aparece sozinha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте страницу в Safari, и список заполнится сам."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 開啟任一網站，這裡就會顯示資料。"
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح أي صفحة في Safari مرة، وستظهر البيانات هنا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari में कोई भी पेज खोलें, सूची अपने आप भर जाएगी।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở một trang bất kỳ trong Safari, danh sách sẽ tự hiện."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari'de bir sayfa açın, liste kendiliğinden dolar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystarczy otworzyć stronę w Safari, by się uzupełniła."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een pagina in Safari en dit vult zich vanzelf."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดหน้าเว็บใดก็ได้ใน Safari สักครั้ง แล้วหน้านี้จะมีข้อมูลเอง"
          }
        }
      }
    },
    "Press the Undirect button in Safari on a site that keeps redirecting.": {
      "extractionState": "manual",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el botón de Undirect en Safari cuando un sitio te redirija."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le bouton Undirect dans Safari pour protéger un site."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "困ったサイトを開いた状態で、Safariのツールバーにあるボタンを押すと保護が始まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在爱乱跳转的网站上点一下 Safari 工具栏的 Undirect 图标，即可开启防护。"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf das Undirect-Symbol in Safari, um die Website zu schützen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan tombol Undirect di bilah alat Safari pada situs yang bermasalah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi il pulsante Undirect nella barra di Safari su un sito problematico."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 있는 사이트에서 Safari 도구 막대의 Undirect 버튼을 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão do Undirect, na barra do Safari, para proteger um site."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите Undirect на панели Safari, когда сайт начинает мешать."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 工具列按下 Undirect 按鈕，就能防護目前的網站。"
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط زر Undirect في شريط أدوات Safari عند زيارة موقع يسيء التصرف."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो साइट परेशान करे, वहां Safari के टूलबार में Undirect बटन दबाएं।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn nút Undirect trên thanh công cụ khi đang ở trang hay gây phiền."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorun çıkaran bir sitede Safari araç çubuğundaki Undirect düğmesine basın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystarczy nacisnąć przycisk Undirect na pasku Safari, by włączyć ochronę."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op de Undirect-knop in Safari terwijl je op een lastige site bent."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดปุ่ม Undirect บนแถบเครื่องมือของ Safari ขณะอยู่ในไซต์ที่มีปัญหา เพื่อเริ่มป้องกัน"
          }
        }
      }
    },
    "Safari did not answer. Switching it on there is picked up automatically.": {
      "extractionState": "manual",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido confirmarlo. Si la activas en Safari, la app lo notará sola."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari n'a pas répondu cette fois. Si vous l'activez, l'app le remarquera seule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariの確認がうまくいきませんでした。拡張機能をオンにすれば、このアプリが自動で気づきます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次没能从 Safari 得到答复；如果你已经启用扩展，本应用会自动发现。"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari antwortete nicht. Wird die Erweiterung aktiviert, erkennt Undirect das von selbst."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari tak bisa memastikan status ekstensi. Aktifkan saja, aplikasi ini akan tahu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare Safari. Se attivi l'estensione, verrà rilevata da sola."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari에서 상태를 확인하지 못했습니다. 확장 프로그램을 켜면 앱이 스스로 알아챕니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Safari não respondeu dessa vez. Se você ativar a extensão lá, o app percebe sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari не ответил сейчас, но при включении расширения приложение заметит это само."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次暫時問不到 Safari 的狀態，只要延伸功能開啟，這裡就會自動更新。"
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التأكد الآن، وسيلاحظ التطبيق تفعيل الإضافة في Safari بمجرد حدوثه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बार Safari से जवाब नहीं मिला। एक्सटेंशन चालू करते ही ऐप खुद जान जाएगा।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hỏi được Safari lần này. Nếu tiện ích đã bật, ứng dụng sẽ tự nhận ra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari'den yanıt alınamadı. Uzantıyı açarsanız uygulama bunu kendiliğinden fark eder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari nie potwierdziło stanu rozszerzenia. Aplikacja sama to zauważy."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari gaf geen antwoord. Zet de extensie aan en de app merkt het vanzelf."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปตรวจสอบกับ Safari ไม่สำเร็จในครั้งนี้ แต่ถ้าเปิดส่วนขยายใน Safari แอปจะทราบเองโดยไม่ต้องรีเฟรช"
          }
        }
      }
    },
