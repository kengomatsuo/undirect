          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuralsız Hedefler İçin Varsayılan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślne działanie dla nowych celów"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaardbeleid voor nieuwe bestemmingen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าเริ่มต้นสำหรับปลายทางที่ไม่มีกฎ"
          }
        }
      }
    },
    "A new tab opens only where your press pointed.": {
      "extractionState": "manual",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la protección activa, la pestaña solo abre donde apuntabas."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouvel onglet ne s'ouvre que là où vous avez vraiment appuyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護中は、押した場所が開くタブだけが開き、余計なものは紛れ込みません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防护开启后，新标签页只会打开你点的那个目的地，不会额外夹带别的。"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Tab öffnet nur das Ziel, das Sie tatsächlich angeklickt haben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab baru hanya terbuka ke tujuan yang kamu tekan, tidak ada yang menyelinap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la protezione attiva, si apre solo la scheda che hai scelto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가드를 켜면 누른 곳으로만 새 탭이 열리고, 다른 것은 끼어들지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a proteção ativa, uma aba nova só abre onde você realmente tocou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С защитой новая вкладка откроет только то, что вы нажали."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防護開啟後，新分頁只會開向你點按的目的地，不會多開別的。"
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "مع الحماية، لا يفتح تبويب جديد إلا فيما ضغطت عليه فعلًا، بلا إضافات خفية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षा के साथ नया टैब सिर्फ़ वहीं खुलेगा, जहां आपने टैप किया।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật bảo vệ, tab mới chỉ mở đúng nơi cú nhấn nhắm tới."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koruma açıkken yeni sekme yalnızca bastığınız yere açılır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z włączoną ochroną nowa karta otwiera tylko to, co naciśnięto."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Met bescherming aan opent een nieuw tabblad alleen waar je zelf op klikte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดการป้องกัน แท็บใหม่จะเปิดไปยังปลายทางที่คุณกดเท่านั้น ไม่มีอะไรแอบตามมา"
          }
        }
      }
    },
    "A page can cover itself to catch a press meant for something else.": {
      "extractionState": "manual",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Una capa invisible cubre la página y desvía tu pulsación."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couche invisible peut intercepter un appui destiné à autre chose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "透明な層がページに重なり、押した場所とは違うものが反応します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面上可能盖着一层看不见的东西，你点的不是你以为点的地方。"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine unsichtbare Ebene liegt über der Seite und fängt den Klick ab."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapisan tak terlihat bisa menutupi halaman dan mengubah arah klikmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno strato invisibile può coprire la pagina e intercettare la pressione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보이지 않는 막이 화면을 덮어 다른 곳이 대신 눌립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma camada invisível cobre a página e desvia o seu toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невидимый слой может перехватить нажатие, предназначенное для другого."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看不見的覆蓋層可能蓋住頁面，讓點按落在別的東西上。"
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تُخفي الصفحة طبقة فوقها، فتصل ضغطتك إلى شيء آخر غير الذي تراه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई अदृश्य परत असली बटन पर बिछकर आपका टैप कहीं और भेज सकती है।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lớp vô hình có thể phủ lên trang, khiến cú nhấn trúng nhầm chỗ khác."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünmez bir katman dokunuşunuzu başka yere kaydırabilir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niewidoczna warstwa na stronie potrafi przejąć kliknięcie w coś innego."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een onzichtbare laag vangt je klik op en stuurt hem ergens anders heen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลเยอร์ที่มองไม่เห็นอาจซ้อนอยู่บนหน้าเว็บ ทำให้การกดสิ่งหนึ่งไปโดนอีกสิ่งหนึ่งแทน"
          }
        }
      }
    },
