        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தளங்கள் Safari-யின் Undirect பொத்தானால் சேர்க்கப்படும். இங்கே நீக்க மட்டுமே முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సైట్‌లు Safari లోని Undirect బటన్ ద్వారా చేరతాయి. ఇక్కడ తొలగించడం మాత్రమే సాధ్యం."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
