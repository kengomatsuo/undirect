            "value": "Sites are added from the Undirect button in Safari."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites are added from the Undirect button in Safari."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sitios se agregan desde el botón de Undirect en Safari; aquí solo puedes quitarlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sivustot lisätään Safarin Undirect-painikkeesta. Täällä niitä voi vain poistaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sites s'ajoutent depuis le bouton Undirect de Safari; ici, vous pouvez seulement en retirer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાઇટ Safari ના Undirect બટનથી ઉમેરાય છે. અહીં ફક્ત કાઢી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתרים מתווספים מהלחצן של Undirect ב-Safari. כאן אפשר רק להסיר אותם."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjesta se dodaju gumbom Undirect u Safariju; ovdje ih možete samo ukloniti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az oldalak a Safari Undirect gombjával kerülnek ide; itt csak eltávolítani lehet őket."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೈಟ್‌ಗಳು Safari ಯ Undirect ಬಟನ್‌ನಿಂದ ಸೇರುತ್ತವೆ. ಇಲ್ಲಿ ತೆಗೆದುಹಾಕಲು ಮಾತ್ರ ಸಾಧ್ಯ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൈറ്റുകൾ ചേർക്കുന്നത് Safari-യിലെ Undirect ബട്ടൺ വഴിയാണ്. ഇവിടെ നീക്കം ചെയ്യാൻ മാത്രം കഴിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "साइट Safari मधील Undirect बटणाने जोडल्या जातात. इथे फक्त काढता येतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laman ditambah daripada butang Undirect dalam Safari. Di sini anda hanya boleh mengalih keluarnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettsteder legges til fra Undirect-knappen i Safari. Her kan du bare fjerne dem."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସାଇଟ Safari ର Undirect ବଟନରୁ ଯୋଡ଼ାଯାଏ। ଏଠାରେ କେବଳ ହଟାଇହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਈਟਾਂ Safari ਦੇ Undirect ਬਟਨ ਤੋਂ ਜੁੜਦੀਆਂ ਹਨ। ਇੱਥੇ ਸਿਰਫ਼ ਹਟਾਈਆਂ ਜਾ ਸਕਦੀਆਂ ਹਨ।"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sites adicionam-se a partir do botão do Undirect no Safari; aqui só os pode remover."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Site-urile se adaugă din butonul Undirect din Safari; aici le poți doar elimina."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Weby sa pridávajú tlačidlom Undirect v Safari; tu ich možno len odstrániť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesta dodate z gumbom Undirect v Safariju; tukaj jih lahko samo odstranite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
