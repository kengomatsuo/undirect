          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A new tab opens only where your press pointed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A new tab opens only where your press pointed."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la protección activa, una pestaña nueva solo se abre adonde apuntaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun suojaus on päällä, uusi välilehti aukeaa vain sinne, mihin napautit."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la protection est active, un nouvel onglet ne s'ouvre qu'à l'endroit où vous avez cliqué."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સુરક્ષા ચાલુ હોય ત્યારે નવું ટૅબ ફક્ત તમે જ્યાં ટૅપ કર્યું ત્યાં જ ખૂલે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשההגנה פעילה, לשונית חדשה נפתחת רק למקום שאליו הקשת."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je zaštita uključena, nova kartica otvara se samo tamo gdje ste dodirnuli."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolt védelemnél új lap csak oda nyílik, ahová koppintottál."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರಕ್ಷಣೆ ಆನ್ ಇದ್ದಾಗ ಹೊಸ ಟ್ಯಾಬ್ ನೀವು ಟ್ಯಾಪ್ ಮಾಡಿದ ಕಡೆಗೆ ಮಾತ್ರ ತೆರೆಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സംരക്ഷണം ഓണായിരിക്കുമ്പോൾ പുതിയ ടാബ് നിങ്ങൾ ടാപ്പ് ചെയ്തിടത്തേക്ക് മാത്രം തുറക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संरक्षण सुरू असताना नवीन टॅब तुम्ही टॅप केलेल्या ठिकाणीच उघडतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila perlindungan hidup, tab baharu hanya dibuka di tempat yang anda ketik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når beskyttelsen er på, åpnes en ny fane bare dit du trykket."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସୁରକ୍ଷା ଚାଲୁ ଥିଲେ ନୂଆ ଟ୍ୟାବ କେବଳ ଆପଣ ଟ୍ୟାପ କରିଥିବା ସ୍ଥାନରେ ଖୋଲେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੁਰੱਖਿਆ ਚਾਲੂ ਹੋਣ 'ਤੇ ਨਵਾਂ ਟੈਬ ਸਿਰਫ਼ ਉੱਥੇ ਖੁੱਲ੍ਹਦਾ ਹੈ ਜਿੱਥੇ ਤੁਸੀਂ ਟੈਪ ਕੀਤਾ।"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a proteção ativa, um separador novo só abre onde clicou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu protecția pornită, o filă nouă se deschide doar unde ai atins."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri zapnutej ochrane sa nová karta otvorí len tam, kam ste ťukli."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je zaščita vklopljena, se nov zavihek odpre samo tja, kamor ste se dotaknili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med skyddet på öppnas en ny flik bara dit du tryckte."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாதுகாப்பு இயக்கத்தில் இருக்கும்போது, புதிய தாவல் நீங்கள் தட்டிய இடத்துக்கு மட்டுமே திறக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రక్షణ ఆన్‌లో ఉన్నప్పుడు కొత్త ట్యాబ్ మీరు ట్యాప్ చేసిన చోటుకే తెరుచుకుంటుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли захист увімкнено, нова вкладка відкривається лише там, де ви торкнулися."
