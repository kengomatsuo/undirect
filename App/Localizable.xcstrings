        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hỏi được Safari lần này. Nếu tiện ích đã bật, ứng dụng sẽ tự nhận ra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari'den yanıt alınamadı. Uzantıyı açarsanız uygulama bunu kendiliğinden fark eder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari nie potwierdziło stanu rozszerzenia. Aplikacja sama to zauważy."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari gaf geen antwoord. Zet de extensie aan en de app merkt het vanzelf."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปตรวจสอบกับ Safari ไม่สำเร็จในครั้งนี้ แต่ถ้าเปิดส่วนขยายใน Safari แอปจะทราบเองโดยไม่ต้องรีเฟรช"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এবার Safari সাড়া দেয়নি। এক্সটেনশন চালু করলে অ্যাপ নিজেই তা বুঝে নেবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta vegada Safari no ha respost. Si actives l'extensió, l'app ho notarà soleta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari tentokrát neodpovědělo. Pokud rozšíření zapnete, aplikace si toho všimne sama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari svarede ikke denne gang. Slår du udvidelsen til, opdager appen det af sig selv."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Safari δεν απάντησε αυτή τη φορά. Αν ενεργοποιήσεις την επέκταση, η εφαρμογή θα το καταλάβει μόνη της."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari did not answer. Switching it on there is picked up automatically."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari did not answer. Switching it on there is picked up automatically."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari did not answer. Switching it on there is picked up automatically."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari no respondió esta vez. Si activas la extensión, la app lo detectará sola."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari ei vastannut tällä kertaa. Jos otat laajennuksen käyttöön, appi huomaa sen itse."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari n'a pas répondu cette fois. Si vous activez l'extension, l'app s'en apercevra d'elle-même."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ વખતે Safari એ જવાબ આપ્યો નહીં. એક્સ્ટેંશન ચાલુ કરશો તો ઍપ જાતે જ જાણી લેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari לא הגיב הפעם. אם תפעיל את ההרחבה, האפליקציה תזהה את זה בעצמה."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari ovaj put nije odgovorio. Ako uključite proširenje, aplikacija će to sama primijetiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Safari ezúttal nem válaszolt. Ha bekapcsolod a bővítményt, az app magától észreveszi."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಬಾರಿ Safari ಉತ್ತರಿಸಲಿಲ್ಲ. ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಆನ್ ಮಾಡಿದರೆ ಆ್ಯಪ್ ತಾನೇ ಗುರುತಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത്തവണ Safari പ്രതികരിച്ചില്ല. എക്സ്റ്റൻഷൻ ഓൺ ആക്കിയാൽ ആപ്പ് സ്വയം അറിഞ്ഞുകൊള്ളും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यावेळी Safari ने उत्तर दिले नाही. एक्स्टेन्शन सुरू केल्यास अॅपला ते आपोआप कळेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari tidak menjawab kali ini. Jika anda menghidupkan sambungan itu, app akan menyedarinya sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari svarte ikke denne gangen. Slår du på utvidelsen, oppdager appen det selv."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏଥର Safari ଉତ୍ତର ଦେଲା ନାହିଁ। ଏକ୍ସଟେନସନ ଚାଲୁ କଲେ ଆପ୍ ନିଜେ ଜାଣିପାରିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਵਾਰ Safari ਨੇ ਜਵਾਬ ਨਹੀਂ ਦਿੱਤਾ। ਐਕਸਟੈਂਸ਼ਨ ਚਾਲੂ ਕਰੋਗੇ ਤਾਂ ਐਪ ਆਪੇ ਜਾਣ ਲਵੇਗੀ।"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Safari não respondeu desta vez. Se ativar a extensão, a app dá por isso sozinha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De data asta Safari nu a răspuns. Dacă activezi extensia, aplicația își dă seama singură."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari tentoraz neodpovedalo. Ak rozšírenie zapnete, aplikácia si to všimne sama."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari se tokrat ni odzval. Če razširitev vklopite, bo aplikacija to opazila sama."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari svarade inte den här gången. Aktiverar du tillägget märker appen det själv."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த முறை Safari பதிலளிக்கவில்லை. நீட்டிப்பை இயக்கினால் செயலி தானாகவே அறிந்துகொள்ளும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈసారి Safari స్పందించలేదు. ఎక్స్‌టెన్షన్‌ను ఆన్ చేస్తే యాప్ తనంతట తానే గుర్తిస్తుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього разу Safari не відповів. Якщо ввімкнути розширення, застосунок помітить це сам."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس بار Safari نے جواب نہیں دیا۔ ایکسٹینشن آن کرنے پر ایپ خود پتا لگا لے گی۔"
          }
        }
      }
    },
