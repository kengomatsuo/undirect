    "It guards a site once you press Undirect in Safari there.": {
      "extractionState": "manual",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el botón de Undirect en la barra de Safari para protegerlo."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton Undirect de Safari active la protection sur le site affiché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのサイトを開いた状態でSafariのツールバーのUndirectボタンを押すと、そのサイトの保護がオンになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在某个网站上点一下 Safari 工具栏里的 Undirect 图标，就能为这个网站开启防护。"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp auf das Undirect-Symbol schaltet den Schutz für diese Website ein."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan tombol Undirect di bilah alat Safari untuk mengaktifkan pelindung di situs itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi il pulsante Undirect nella barra di Safari su quel sito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 도구 막대의 Undirect 버튼을 누르면 그 사이트의 가드가 켜집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão do Undirect, na barra do Safari, para proteger o site atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка Undirect на панели Safari включает защиту для этого сайта."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 工具列按下 Undirect 按鈕，就能為這個網站開啟防護。"
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط زر Undirect في شريط أدوات Safari لتفعيل الحماية على ذلك الموقع فقط."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari के टूलबार में Undirect बटन दबाकर उस साइट की सुरक्षा चालू करें।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn nút Undirect trên thanh công cụ Safari để bảo vệ trang đang mở."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari araç çubuğundaki Undirect düğmesine basmak o siteyi korumaya alır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ochronę włącza się przyciskiem Undirect na pasku Safari."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op de Undirect-knop in Safari om die site te beveiligen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดปุ่ม Undirect บนแถบเครื่องมือ Safari ขณะอยู่ในไซต์นั้น เพื่อเปิดการป้องกันให้ไซต์นั้น"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো সাইটে Safari-র টুলবারের Undirect বোতামে চাপ দিলে সেই সাইটে সুরক্ষা চালু হয়।"
