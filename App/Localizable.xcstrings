    "A destination shows up once you allow or block it.": {
      "extractionState": "manual",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla aparece aquí solo cuando decides algo."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle apparaît après votre premier choix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動先を許可またはブロックすると、ここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你亲自允许或拦截过某个目的地，它才会出现在这里。"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Regel entsteht erst, wenn Sie entscheiden."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tujuan muncul di sini begitu kamu mengizinkan atau memblokirnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regola compare solo dopo una decisione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상을 직접 허용하거나 차단해야 목록에 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra só aparece depois que você decide algo sobre um destino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило появится здесь, когда вы примете решение."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許或封鎖過目的地後，才會出現在這裡。"
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الوجهة هنا فقط بعد أن تسمح بها أو تحظرها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियम तभी बनता है जब आप कोई फ़ैसला लेते हैं।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đích đến chỉ hiện ở đây khi đã được cho phép hoặc chặn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hedef, ancak siz karar verince listeye girer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpis pojawia się dopiero po podjęciu decyzji o celu."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas als je kiest, verschijnt hier een regel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการจะปรากฏก็ต่อเมื่อคุณอนุญาตหรือบล็อกปลายทางนั้นแล้ว"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি দিলে বা আটকালে তবেই গন্তব্য এখানে দেখা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un destí apareix aquí quan el permets o el bloquejes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cíl se tu objeví, jakmile ho povolíte nebo zablokujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et mål dukker op her, når du har tilladt eller blokeret det."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας προορισμός εμφανίζεται εδώ όταν τον επιτρέψεις ή τον αποκλείσεις."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A destination shows up once you allow or block it."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A destination shows up once you allow or block it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A destination shows up once you allow or block it."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un destino aparece aquí cuando decides permitirlo o bloquearlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohde ilmestyy tänne, kun olet sallinut tai estänyt sen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une destination apparaît ici une fois que vous l'avez autorisée ou bloquée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે મંજૂરી આપો કે બ્લૉક કરો પછી જ ગંતવ્ય અહીં દેખાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יעד מופיע כאן אחרי שאישרתם או חסמתם אותו."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odredište se ovdje pojavi kad ga dopustite ili blokirate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A cél itt jelenik meg, miután engedélyezted vagy letiltottad."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಅನುಮತಿಸಿದ ಅಥವಾ ನಿರ್ಬಂಧಿಸಿದ ನಂತರವೇ ಗಮ್ಯಸ್ಥಾನ ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ അനുവദിക്കുകയോ തടയുകയോ ചെയ്താൽ മാത്രമേ ലക്ഷ്യസ്ഥാനം ഇവിടെ വരൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही परवानगी दिल्यावर किंवा ब्लॉक केल्यावरच गंतव्य इथे दिसते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinasi muncul di sini selepas anda membenarkan atau menyekatnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et mål dukker opp her når du har tillatt eller blokkert det."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଅନୁମତି ଦେଲେ କିମ୍ବା ବ୍ଲକ କଲେ ହିଁ ଗନ୍ତବ୍ୟ ଏଠାରେ ଦେଖାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਇਜਾਜ਼ਤ ਦੇਣ ਜਾਂ ਰੋਕਣ ਤੋਂ ਬਾਅਦ ਹੀ ਮੰਜ਼ਿਲ ਇੱਥੇ ਦਿਸਦੀ ਹੈ।"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um destino aparece aqui depois de o permitir ou bloquear."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O destinație apare aici după ce o permiți sau o blochezi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cieľ sa tu zobrazí, keď ho povolíte alebo zablokujete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cilj se tu pojavi, ko ga dovolite ali blokirate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett mål dyker upp här när du har tillåtit eller blockerat det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அனுமதித்த அல்லது தடுத்த பிறகே இலக்கு இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు అనుమతించిన లేదా బ్లాక్ చేసిన తర్వాతే గమ్యం ఇక్కడ కనిపిస్తుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пункт призначення з'являється тут, коли ви дозволите або заблокуєте його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منزل تبھی یہاں نظر آتی ہے جب آپ اسے اجازت دیں یا بلاک کریں۔"
          }
        }
