    "Each one is listed, to allow or block per site or everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada destino queda registrado: decide si permitirlo aquí o en todos los sitios."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque destination devient une ligne à autoriser ou bloquer, ici ou partout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つかった移動先はすべて一覧に残り、このサイトだけか、すべてのサイトかを選んで許可・ブロックできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防护看到的每个目的地都会单独列出，你可以按本站或所有网站分别选择放行或拦截。"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Ziel wird aufgeführt, und Sie entscheiden: hier oder überall."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiap tujuan tercatat, dan kamu bisa mengizinkannya atau memblokirnya, di sini atau di semua situs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni destinazione diventa una riga che puoi consentire o bloccare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발견된 대상마다 목록에 남아, 이 사이트나 전체에서 허용할지 차단할지 정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você revisa cada destino e decide: aqui ou em todos os sites."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый адрес попадает в список, где вы разрешаете или блокируете его."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個目的地都會列出來，你可以選擇在這個網站或所有網站允許或封鎖。"
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لكل وجهة سجل خاص، تختار فيه السماح أو الحظر هنا أو في كل مكان."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर गंतव्य की अलग एंट्री बनती है, जिसे आप यहां या हर जगह के लिए तय कर सकते हैं।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi đích đến có mục riêng để chọn cho phép hay chặn, tại đây hoặc mọi nơi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gördüğü her hedefi listeler; sitede ya da her yerde izin verin ya da engelleyin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy cel ma własny wpis do zablokowania lub zezwolenia tu albo wszędzie."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke bestemming krijgt een regel: toestaan of blokkeren, hier of overal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกปลายทางที่พบจะมีรายการให้ตรวจสอบ เลือกอนุญาตหรือบล็อกได้ทั้งที่นี่หรือทุกไซต์"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি গন্তব্য আলাদা সারিতে থাকে। একটি সাইটে বা সব সাইটে তা অনুমতি দিতে বা আটকাতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada destí queda en una llista: el pots permetre o bloquejar, en un lloc o en tots."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý cíl má svůj řádek: povolíte ho nebo zablokujete na jednom webu, nebo všude."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert mål får sin egen række. Du kan tillade eller blokere det på ét websted eller alle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε προορισμός παίρνει τη δική του γραμμή: τον επιτρέπεις ή τον αποκλείεις σε έναν ιστότοπο ή σε όλους."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Each one is listed, to allow or block per site or everywhere."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Each one is listed, to allow or block per site or everywhere."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Each one is listed, to allow or block per site or everywhere."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada destino queda en una lista: lo permites o lo bloqueas en un sitio o en todos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kohde saa oman rivinsä. Sen voi sallia tai estää yhdellä sivustolla tai kaikilla."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque destination figure dans une liste : autorisez-la ou bloquez-la, sur un site ou partout."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક ગંતવ્યની અલગ હરોળ બને છે. એક સાઇટ માટે કે બધી સાઇટ માટે તેને મંજૂરી આપો અથવા બ્લૉક કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל יעד מקבל שורה משלו, ואפשר לאשר או לחסום אותו באתר אחד או בכל האתרים."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako odredište dobiva svoj redak: dopustite ga ili blokirajte na jednom ili na svim web-mjestima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden cél külön sort kap, és egy oldalon vagy mindenhol engedélyezheted vagy letilthatod."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಗಮ್ಯಸ್ಥಾನಕ್ಕೂ ಒಂದು ಸಾಲು ಇರುತ್ತದೆ. ಒಂದು ಸೈಟ್‌ನಲ್ಲಿ ಅಥವಾ ಎಲ್ಲೆಡೆ ಅನುಮತಿಸಿ ಅಥವಾ ನಿರ್ಬಂಧಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ലക്ഷ്യസ്ഥാനത്തിനും ഒരു വരി ഉണ്ടാകും. ഒരു സൈറ്റിലോ എല്ലായിടത്തോ അനുവദിക്കുകയോ തടയുകയോ ചെയ്യാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक गंतव्याची स्वतंत्र ओळ असते. एका साइटवर किंवा सर्वत्र त्याला परवानगी द्या किंवा ब्लॉक करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap destinasi mendapat barisnya sendiri. Anda boleh membenarkan atau menyekatnya pada satu laman atau semua laman."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert mål får sin egen rad. Du kan tillate eller blokkere det på ett nettsted eller på alle."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ଗନ୍ତବ୍ୟର ନିଜସ୍ୱ ଧାଡ଼ି ଥାଏ। ଗୋଟିଏ ସାଇଟରେ ବା ସବୁଠି ଅନୁମତି ଦିଅନ୍ତୁ କିମ୍ବା ବ୍ଲକ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਮੰਜ਼ਿਲ ਦੀ ਆਪਣੀ ਕਤਾਰ ਬਣਦੀ ਹੈ। ਇੱਕ ਸਾਈਟ ਜਾਂ ਸਾਰੀਆਂ ਸਾਈਟਾਂ 'ਤੇ ਇਜਾਜ਼ਤ ਦਿਓ ਜਾਂ ਰੋਕੋ।"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada destino fica numa lista: permita ou bloqueie, num site ou em todos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare destinație primește propriul rând: o permiți sau o blochezi pe un site ori pe toate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý cieľ dostane vlastný riadok: povolíte ho alebo zablokujete na jednom webe, alebo všade."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak cilj dobi svojo vrstico: dovolite ali blokirate ga lahko na enem spletnem mestu ali povsod."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje mål får en egen rad. Du kan tillåta eller blockera det på en webbplats eller på alla."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு இலக்கிற்கும் தனி வரிசை இருக்கும். ஒரு தளத்திலோ எல்லா தளங்களிலோ அனுமதிக்கலாம் அல்லது தடுக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి గమ్యానికి ప్రత్యేక వరుస ఉంటుంది. ఒక సైట్‌లో లేదా అన్నిటిలో అనుమతించవచ్చు లేదా బ్లాక్ చేయవచ్చు."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен пункт призначення має свій рядок: його можна дозволити або заблокувати на одному сайті чи на всіх."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر منزل کی اپنی الگ قطار بنتی ہے۔ ایک سائٹ پر یا ہر جگہ اسے اجازت دیں یا بلاک کریں۔"
          }
        }
      }
    },
