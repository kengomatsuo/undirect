    "Sites are added from the Undirect button in Safari.": {
      "extractionState": "manual",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadir un sitio, usa el botón de Undirect en Safari."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette liste s'allonge depuis le bouton Undirect de Safari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトを増やすには、Safariのツールバーのボタンを使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站只能通过 Safari 工具栏里的图标添加，这里无法新增。"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Websites fügen Sie über Safaris Symbolleiste hinzu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Situs baru masuk daftar ini hanya lewat tombol Undirect di Safari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi altri siti dal pulsante Undirect in Safari."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 사이트는 Safari 도구 막대의 버튼으로만 추가됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites só entram nesta lista pelo botão do Undirect, no Safari."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые сайты добавляются только кнопкой в Safari."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能透過 Safari 工具列的按鈕新增網站。"
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضاف المواقع من زر Undirect في Safari فقط، لا من هنا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई साइट जोड़ने का तरीका सिर्फ़ Safari का टूलबार बटन है।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muốn thêm trang, dùng nút Undirect trên thanh công cụ Safari."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni site yalnızca Safari'deki düğmeyle eklenir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe witryny dodaje przycisk Undirect w pasku Safari."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe sites voeg je toe via de knop in Safari's werkbalk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มไซต์ใหม่ได้จากปุ่ม Undirect ใน Safari เท่านั้น หน้านี้ลบไซต์ได้อย่างเดียว"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইট যোগ হয় Safari-র Undirect বোতাম থেকে। এখানে শুধু সরানো যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els llocs s'afegeixen des del botó de l'Undirect al Safari; aquí només els pots treure."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Weby se přidávají tlačítkem Undirect v Safari; tady je lze jen odebrat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Websteder tilføjes fra Undirect-knappen i Safari. Her kan du kun fjerne dem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ιστότοποι προστίθενται από το κουμπί Undirect στο Safari· εδώ μπορείς μόνο να τους αφαιρέσεις."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites are added from the Undirect button in Safari."
          }
        },
        "en-CA": {
          "stringUnit": {
