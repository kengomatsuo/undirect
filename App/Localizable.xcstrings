        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تحفظ آن ہو تو نیا ٹیب صرف وہیں کھلتا ہے جہاں آپ نے ٹیپ کیا۔"
          }
        }
      }
